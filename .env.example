# RECALLX AI — Environment Configuration Example

# Security & Authentication
SECRET_KEY=recallx-super-secure-production-jwt-key-2026-hackathon
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Supports PostgreSQL with automated fallback to SQLite for zero-config local runs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recallx

# AI Inference (Groq)
# Recommended models: llama-3.3-70b-versatile, openai/gpt-oss-120b, or qwen/qwen3-32b
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Official Memory Layer
# Documentation: https://hindsight.vectorize.io/
# Local Docker instance: http://localhost:8888
# Cloud instance: https://api.hindsight.vectorize.io
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=your_hindsight_api_key_if_using_cloud
DEFAULT_BANK_ID=recallx-sre-workspace
